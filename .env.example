# Agentic RAG 企业智能搜索与自动调研系统
# 环境变量配置模板 → 复制为 .env 并填入真实值
# ⚠️  .env 需放在 D:\agentic-rag-system\backend\ 下（与 app/ 同级）
#     或者放在项目根目录，代码会自动向上查找

# === LLM 配置 ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# LLM-as-judge 评测用（RAGAS）。默认复用主模型 DeepSeek；也可接独立 OpenAI 模型做交叉评测
JUDGE_MODEL=deepseek-chat
JUDGE_BASE_URL=https://api.deepseek.com/v1
JUDGE_API_KEY=sk-your-key-here

# === 数据库（PostgreSQL + pgvector）===
DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5432/rag_db
SYNC_DATABASE_URL=postgresql://rag_user:rag_pass@localhost:5432/rag_db

# === Redis（BM25 索引 / 缓存）===
REDIS_URL=redis://localhost:6379/0

# === Embedding（BGE 本地模型）===
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ENABLED=true

# === JWT 鉴权 ===
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === 服务端口 ===
HOST=0.0.0.0
PORT=8000

# === LangGraph Checkpointer ===
CHECKPOINT_POSTGRES_URI=postgresql://rag_user:rag_pass@localhost:5432/rag_db

# === 文件上传 ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.md,.txt,.html

# === 报告 PDF 导出（Chrome headless 渲染）===
CHROME_PATH=C:/Users/27809/AppData/Local/Google/Chrome/Application/chrome.exe
